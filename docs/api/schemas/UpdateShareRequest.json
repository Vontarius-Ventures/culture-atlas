  "type": "object",
  "properties": {
    "include_media": {
      "type": "boolean"
    },
    "allow_originals": {
      "type": "boolean"
    },
    "expires_in_days": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 7
        },
        {
          "type": "number",
          "const": 30
        }
      ]
    },
    "confirm_broaden": {
      "default": false,
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
