{
  "$id": "https://culture-atlas.invalid/schemas/v2/CommandAck.json",
  "title": "CommandAck",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "awaiting_user",
        "executing",
        "succeeded",
        "failed",
        "unknown"
      ]
    },
    "result_asset_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "safe_error": {
      "type": "string",
      "enum": [
        "device_unavailable",
        "permission_denied",
        "interrupted",
        "storage_full",
        "outcome_unknown"
      ]
    }
  },
  "required": [
    "sequence",
    "state"
  ],
  "additionalProperties": false
}
