{
  "$id": "https://culture-atlas.invalid/schemas/v2/CreateAgentConnection.json",
  "title": "CreateAgentConnection",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "scopes": {
      "default": [
        "setup:read",
        "preferences:read"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "captures:read",
          "captures:write",
          "collections:read",
          "collections:write",
          "taste:read",
          "taste:write",
          "plans:read",
          "plans:write",
          "setup:read",
          "preferences:read",
          "preferences:write",
          "media:read",
          "media:download",
          "media:write",
          "media:analyze",
          "devices:command"
        ]
      }
    },
    "library_access": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "selected_collections",
        "all"
      ]
    },
    "collection_ids": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "installation_ids": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "expires_in_days": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    }
  },
  "required": [
    "client_name"
  ],
  "additionalProperties": false
}
