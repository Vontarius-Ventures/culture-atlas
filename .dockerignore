# Never send secrets or local state to the build.
.env
.env.*
!.env.example
.data/
.git/
.github/
.claude/

# Build output and dependencies are rebuilt inside the image.
**/node_modules/
**/.next/
**/dist/
**/*.tsbuildinfo
coverage/
test-results/
playwright-report/

# Not needed at runtime (design references, research notes and the spec stay in the repo).
design/
research/
specs/
