# Proposed v2 configuration contract. Current application does not implement these additions yet.
# Load secrets through hosted secret management; never commit real values.
LLM_PROVIDER=concentrate
CONCENTRATE_API_KEY=
CONCENTRATE_BASE_URL=https://api.concentrate.ai/v1
# Exact provider/model IDs selected and pinned after account/catalog/fixture qualification.
VLM_MODEL=
RESEARCH_MODEL=
COMPOSER_MODEL=
CONCENTRATE_PROFILE_FILE=
CONCENTRATE_GATEWAY_FALLBACKS_ENABLED=false
# Assertions verified against key settings; these variables do not configure vendor-side ZDR/logging.
CONCENTRATE_REQUIRE_ZDR=true
CONCENTRATE_ALLOW_CONTENT_LOGGING=false
MODEL_DAILY_SPEND_LIMIT_USD=
MODEL_MAX_UNKNOWN_SPEND_USD=
MEDIA_PHOTO_MAX_BYTES=15728640
MEDIA_PHOTO_MAX_PIXELS=40000000
MEDIA_VIDEO_MAX_BYTES=262144000
MEDIA_VIDEO_MAX_DURATION_SECONDS=120
CAPTURE_VIDEO_MAX_DURATION_SECONDS=60
VIDEO_ANALYSIS_MAX_FRAMES=8
ACCOUNT_MEDIA_QUOTA_BYTES=5368709120
ACCOUNT_DAILY_MEDIA_ANALYSES=50
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_PART_URL_TTL_SECONDS=900
MEDIA_READ_URL_TTL_SECONDS=300
REMOTE_CAPTURE_ARM_SECONDS=600
REMOTE_COMMAND_TTL_SECONDS=30
STORAGE_DRIVER=s3
APP_BASE_URL=
# Existing DATABASE_URL/S3_* /QLOO_API_KEY remain server-managed.
# Native Meta app IDs, client configuration and platform signing use build-specific secure CI config.
# Production backend credentials are never compiled into native apps.
