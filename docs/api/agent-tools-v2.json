    {
      "name": "create_plan",
      "description": "Create a movie-night plan (film, food and music; the only plan template) from 2-5 items of one collection (include expected_revision). Returns immediately; poll get_job, then get_plan. For any other board (a dinner party, a trip, a mood board), use create_collection and add_collection_item instead.",
      "scopes": [
        "plans:write",
        "collections:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "collection_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "item_ids": {
            "minItems": 2,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "template": {
            "type": "string",
            "enum": [
              "movie_night"
            ]
          },
          "fixed_film_item_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "constraints": {
            "type": "object",
            "properties": {
              "dietary_exclusions": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "instruction": {
                "type": "string",
                "maxLength": 280
              }
            },
            "additionalProperties": false
          },
          "exploration": {
            "default": "balanced",
            "type": "string",
            "enum": [
              "familiar",
              "balanced",
              "adventurous"
            ]
          }
        },
        "required": [
          "collection_id",
          "expected_revision",
          "item_ids",
          "template"
        ],
        "additionalProperties": false
      }
    },
