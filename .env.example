# Capture v2 (private media; identity/P2 adapters must be composed at startup).
CAPTURE_MEDIA_CREATION_ENABLED=true
CAPTURE_VIDEO_UPLOAD_ENABLED=true
ACCOUNT_MEDIA_QUOTA_BYTES=5368709120
MEDIA_PHOTO_MAX_BYTES=15728640
MEDIA_PHOTO_MAX_PIXELS=40000000
MEDIA_VIDEO_MAX_BYTES=262144000
# Seconds; can only lower the contract ceiling of 120 (uploads) / 60 (native clips).
MEDIA_VIDEO_MAX_DURATION_SECONDS=
CAPTURE_VIDEO_MAX_DURATION_SECONDS=
# Media worker (pnpm media-worker): ffmpeg/ffprobe binaries, threads per process,
# concurrent jobs and the disposable scratch directory (default: OS temp dir).
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_WORKER_THREADS=
MEDIA_WORKER_CONCURRENCY=
MEDIA_WORKER_SCRATCH_DIR=
# Legacy World Sensor captures enter the v2 library only when true (default false).
CAPTURE_LEGACY_SENSOR_IMPORT_ENABLED=
# Encrypted metadata exports are written outside the repository.
CAPTURE_BACKUP_DIR=
# PG_DUMP_BIN=/path/to/matching/postgresql/bin/pg_dump
# culture atlas environment variables.
# Names only: never commit real values. Defaults (in comments) apply when unset.
# Domain config: packages/domain/src/config.ts
# Provider config: packages/providers/src/config.ts
# Bridge config: apps/sensor-bridge/src/config.ts

# --- On-prem production (docker-compose.yml; docs/production-readiness.md) ---
# Compose reads this file for the ${...} references in docker-compose.yml.
# REQUIRED for production: APP_BASE_URL, APP_HOST, MEDIA_HOST, ACME_EMAIL,
# POSTGRES_PASSWORD, SESSION_SECRET, STORAGE_SIGNING_SECRET, S3_ENDPOINT,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, GARAGE_RPC_SECRET, GARAGE_ADMIN_TOKEN,
# IDENTITY_MAIL_FROM, RESEND_API_KEY.
# "edge" starts Caddy (TLS for APP_HOST + MEDIA_HOST). Clear it only when your
# existing proxy terminates TLS for both hosts.
COMPOSE_PROFILES=edge
# Public host names (DNS A/AAAA -> this machine; ports 80/443 forwarded here).
# APP_HOST is the host of APP_BASE_URL; MEDIA_HOST is the host of S3_ENDPOINT.
APP_HOST=
MEDIA_HOST=
# Let's Encrypt account / certificate expiry notices
ACME_EMAIL=
# openssl rand -hex 24 (letters and digits only: it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=
# Garage object store: openssl rand -hex 32 / openssl rand -base64 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Host ports stay on loopback unless your own proxy runs on another machine
# (default 127.0.0.1; host port for web defaults to 3000).
WEB_BIND_ADDRESS=
GARAGE_BIND_ADDRESS=
PORT=
# Image tag for culture-atlas / culture-atlas-ops (default local)
ATLAS_RELEASE=
# Host directory with Concentrate profiles.json + qualification artifacts,
# mounted read-only at /etc/culture-atlas/concentrate (default ./fixtures/concentrate)
CONCENTRATE_CONFIG_DIR=
# Backups (infra/onprem/atlas-backup.sh): host directory outside the repository
# (default /var/backups/culture-atlas), local retention in days (default 7) and
# an optional rsync target on another machine, e.g. user@nas:/backups/atlas
BACKUP_DIR=
BACKUP_KEEP_DAYS=
BACKUP_OFFSITE_RSYNC=

# --- Runtime ---------------------------------------------------------------
# development | test | production (default development)
NODE_ENV=
# Public base URL of the app, used for cookies (Secure when https) and signed media URLs (default http://localhost:3000)
APP_BASE_URL=
# Apple Developer Team ID used in apple-app-site-association App IDs (default U9XG3X374H, this repo's Signing.xcconfig)
APPLE_TEAM_ID=
# Comma-separated SHA-256 signing-certificate fingerprints for /.well-known/assetlinks.json
# (Play App Signing key, from Play Console -> App integrity). Empty = no certificate listed.
ANDROID_ASSETLINKS_SHA256=
# Debug-keystore fingerprint, added to assetlinks.json outside production only
ANDROID_DEBUG_CERT_SHA256=
# HMAC secret for session tokens and CSRF; REQUIRED in production
SESSION_SECRET=
# base64 32-byte key for AES-256-GCM encryption of sensor viewer credentials
CREDENTIAL_ENCRYPTION_KEY=
# Version tag included in analysis cache keys; bump to invalidate cached analyses
COMPILER_VERSION=

# --- Database --------------------------------------------------------------
# default postgres://culture_atlas:culture_atlas@localhost:5432/culture_atlas
DATABASE_URL=
# default 10
DATABASE_POOL_MAX=
# Base database for tests; each vitest run creates and drops its own database from it
# (default postgres://culture_atlas:culture_atlas@localhost:5432/culture_atlas_test)
TEST_DATABASE_URL=

# --- Sessions, quotas and limits ------------------------------------------
# default 24
ANON_SESSION_TTL_HOURS=
# default 30
ACCOUNT_SESSION_TTL_DAYS=
# Verified account email delivery uses identity.setIdentityMail(adapter) at server startup.
# No production fallback: absent adapter disables email login/recovery with 503.
# Development/test use DevIdentityOutbox in memory, never a log or public endpoint.
# Native policy: 10m access, 30d idle/90d absolute refresh, 60s bounded retry.
# default 30
AGENT_TOKEN_DEFAULT_TTL_DAYS=
# default 15728640 (15 MiB)
UPLOAD_MAX_BYTES=
# default 40000000 decoded pixels
UPLOAD_MAX_PIXELS=
# default 2048 px long edge for the stored derivative
IMAGE_MAX_EDGE=
# Keep original uploads in addition to the derivative (default false)
STORE_ORIGINALS=
# default 10 / 5 per anonymous session per day
ANON_DAILY_ANALYSES=
ANON_DAILY_PLANS=
# default 100 / 50 per account per day
ACCOUNT_DAILY_ANALYSES=
ACCOUNT_DAILY_PLANS=
# Spec amendment 2.2: per-account daily caps on the shared Qloo key (onboarding search; taste seed jobs queued by Settings -> Taste edits).
ACCOUNT_DAILY_ONBOARDING_SEARCHES=
ACCOUNT_DAILY_TASTE_SEEDS=
# default 2000 requests per IP per day
IP_DAILY_REQUESTS=
# Reverse proxies in front of the web app that append to X-Forwarded-For (default 1).
# The client address is read that many entries from the RIGHT; left entries are client-supplied.
TRUSTED_PROXY_HOPS=
# Optional header your edge sets to the verified client address (e.g. cf-connecting-ip).
# Only set it when the platform overwrites client-supplied values; it then wins over X-Forwarded-For.
CLIENT_IP_HEADER=
# Comma-separated account ids allowed to open the demo inspector for their own jobs
DEMO_INSPECTOR_ACCOUNT_IDS=

# --- Worker ----------------------------------------------------------------
# default 5 concurrent jobs
WORKER_CONCURRENCY=
# default 500
WORKER_POLL_MS=
# default 30000 / 10000
JOB_LEASE_MS=
JOB_HEARTBEAT_MS=
# default 3
JOB_MAX_ATTEMPTS=
# default 60000 (per analysis attempt)
ANALYSIS_DEADLINE_MS=
# Per-job budgets (defaults 12 / 5 / 2)
JOB_MAX_QLOO_REQUESTS=
JOB_MAX_RESEARCH_REFS=
JOB_MAX_PROVIDER_RETRIES=

# --- VLM / text models -------------------------------------------------------
# concentrate (default) | featherless | anthropic. Compose and the paid Render
# blueprint set LLM_PROVIDER=concentrate. Featherless/Anthropic are explicit
# operational ROLLBACK options only: nothing falls back to them automatically,
# and v2 media analysis runs only on Concentrate. A missing key, profile,
# qualification, ledger or spend limit leaves that role unavailable; capture,
# library and uploads keep working. See docs/concentrate.md.
LLM_PROVIDER=
# Server-side secret (hosted secret store). Never in web/mobile bundles.
CONCENTRATE_API_KEY=
CONCENTRATE_BASE_URL=https://api.concentrate.ai/v1
# Role profiles: a JSON array (ModelProfileSchema) in a file, or inline for
# hosted parameter stores. Exact provider/model ids only, pinned after qualification.
# Factory catalog pins (no secrets): fixtures/concentrate/profiles.json
CONCENTRATE_PROFILE_FILE=
CONCENTRATE_PROFILES_JSON=
# Directory holding catalog-snapshot.json and qualification artifacts written by
# `pnpm qualify:concentrate`. Only a matching passing artifact makes a role dispatchable.
# Factory catalog snapshot + text-role artifacts (aggregates only): fixtures/concentrate
CONCENTRATE_QUALIFICATION_DIR=
# Demo override, refused when NODE_ENV=production: comma-separated roles whose
# catalog-compatible (unqualified) profile may dispatch, labelled "Experimental
# reading" (e.g. vision_photo,vision_video_frame,vision_photo_enrich). The worker
# prints unqualified roles in red at startup.
CONCENTRATE_DEMO_ALLOW_ROLES=
# Assertions only; independently verify ZDR ON / content logging OFF on the key.
CONCENTRATE_REQUIRE_ZDR=true
CONCENTRATE_ALLOW_CONTENT_LOGGING=false
CONCENTRATE_GATEWAY_FALLBACKS_ENABLED=false
# Required positive ceilings for the PostgreSQL ledger (inference_attempts).
MODEL_DAILY_SPEND_LIMIT_USD=
MODEL_ACCOUNT_DAILY_SPEND_LIMIT_USD=
MODEL_MAX_UNKNOWN_SPEND_USD=
# All-time cumulative paid-spend ceiling (VAL-OPS-002). Daily limits reopen on
# every restart and midnight rollover; this bound never reopens until the
# operator raises it. Paid graph research stays off without it, and the
# mission's shared allowance is $100 (the compose default).
MODEL_TOTAL_SPEND_LIMIT_USD=
ACCOUNT_DAILY_MEDIA_ANALYSES=50
# Operator qualification script only (pnpm qualify:concentrate): path to a chmod-600
# file holding the key. Preferred over CONCENTRATE_API_KEY for that script.
CONCENTRATE_API_KEY_FILE=
# v2 media analysis loop in the worker (default on) and its photo/video slots (2 / 1).
MEDIA_ANALYSIS_WORKER_ENABLED=
MEDIA_ANALYSIS_PHOTO_CONCURRENCY=
MEDIA_ANALYSIS_VIDEO_CONCURRENCY=
# Featherless (rollback only, with LLM_PROVIDER=featherless; OpenAI-compatible API).
# Live catalog 2026-10-22: google/gemma-3-27b-it has features.image_input true.
# Never an automatic fallback from Concentrate. Keys prefixed rc_ are Featherless, not Render.
FEATHERLESS_API_KEY=
# default https://api.featherless.ai/v1
FEATHERLESS_BASE_URL=
# json_schema | json_object | none (default json_object); output is always re-validated
FEATHERLESS_JSON_MODE=
# Anthropic (rollback only, with LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Concentrate (default): no silent dispatch default. After 2026-10-22 catalog
# qualification the documented IDs are anthropic/claude-haiku-5-5 (ZDR listed on
# the anthropic route; jpeg + structured output). Set these as assertions against
# CONCENTRATE_PROFILE_FILE, never as a replacement for a qualified profile.
# Featherless/Anthropic rollback defaults: google/gemma-3-27b-it / claude-sonnet-5-5.
VLM_MODEL=
RESEARCH_MODEL=
# Plan composer model (defaults to RESEARCH_MODEL)
COMPOSER_MODEL=
# default 30000
VLM_TIMEOUT_MS=
# low | medium | high (default medium) effort for VLM and text calls (Anthropic only)
ANTHROPIC_EFFORT=
# Server-side refusal fallback on supported models; disabled automatically with ANTHROPIC_BASE_URL (default true)
ANTHROPIC_REFUSAL_FALLBACK=

# --- Model fallback (optional, operator choice) -------------------------------
# elorian | none (default none). With elorian AND ELORIAN_API_KEY set, Elorian
# (OpenAI-compatible Chat Completions) backs up the vision/text models: it is
# used when Concentrate has no qualified/available role, and as one second try
# after a provider-side failure (unavailable, timeout, incomplete, 429, 5xx).
# Refusals, our own bad requests and per-account allowances never fall through.
MODEL_FALLBACK=
ELORIAN_API_KEY=
# default https://api.elorian.ai/v1
ELORIAN_BASE_URL=
# default elorian-1-agent
ELORIAN_MODEL=
# none (default; Elorian rejects response_format) | json_object | json_schema; output is always re-validated
ELORIAN_JSON_MODE=
# default 30000
ELORIAN_TIMEOUT_MS=

# --- Qloo --------------------------------------------------------------------
# The hackathon key has arrived: set it locally, never commit it. Absent key =>
# every Qloo capability reports unavailable; nothing is fabricated.
QLOO_API_KEY=
# default https://hackathon.api.qloo.com
QLOO_API_URL=
# default 10000
QLOO_TIMEOUT_MS=
# Qloo requests in flight at once per process, shared by onboarding search, the taste seed, analysis and discovery (default 3; the hackathon key throttles bursts).
QLOO_MAX_CONCURRENCY=
# Allow recorded fixtures, always labeled "Example result" (default false)
QLOO_REPLAY_FIXTURES=
# Directory of sanitized real recordings from scripts/probe-qloo.ts --record (e.g. fixtures/qloo/recordings)
QLOO_REPLAY_DIR=

# --- ElevenLabs (Music Mode transcripts → Qloo artist search) ----------------
# Server-held only. Explore still requests music_match; Scribe is an internal seed.
ELEVENLABS_API_KEY=
# default scribe_v2
ELEVENLABS_TRANSCRIPTION_MODEL=
# true: send enable_logging=false (enterprise). Default false: owner-approved Music Mode transcripts.
ELEVENLABS_REQUIRE_ZERO_RETENTION=

# --- Reference research (Wikipedia / Wikimedia) ---------------------------
# default https://en.wikipedia.org/api/rest_v1
WIKIPEDIA_API_URL=
# default https://en.wikipedia.org/w/api.php
WIKIPEDIA_ACTION_API_URL=
# Descriptive User-Agent with contact info, required by Wikimedia
WIKIMEDIA_USER_AGENT=
# default 8000 per Wikipedia request
RESEARCH_TIMEOUT_MS=

# --- Object storage ---------------------------------------------------------
# local | s3 | memory (default local). Production on-prem: docker-compose.yml
# forces s3 against the Garage container (production refuses the filesystem
# driver for v2 media). S3_ENDPOINT is then the public https media host
# (https://$MEDIA_HOST), S3_* keys are the Garage app key, path style is on.
# STORAGE_SIGNING_SECRET is REQUIRED in production (openssl rand -hex 32).
STORAGE_DRIVER=
# default .data/objects
STORAGE_LOCAL_DIR=
# HMAC secret for local signed media URLs
STORAGE_SIGNING_SECRET=
# default 300
SIGNED_URL_TTL_SECONDS=
S3_ENDPOINT=
# default us-east-1
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO-style endpoints (default false)
S3_FORCE_PATH_STYLE=

# --- World Sensor (server-side poller) -------------------------------------
# Comma-separated relay origins an operator may configure
SENSOR_ALLOWED_ORIGINS=
# default 10000
SENSOR_POLL_INTERVAL_MS=
# default 15728640
SENSOR_MAX_ASSET_BYTES=

# --- World Sensor outbound bridge (apps/sensor-bridge, runs beside the relay) ---
BRIDGE_RELAY_ORIGIN=
BRIDGE_VIEWER_CREDENTIAL=
BRIDGE_APP_URL=
BRIDGE_CAPTURE_TOKEN=
BRIDGE_CONNECTION_ID=
# default 10000
BRIDGE_POLL_INTERVAL_MS=
# default .data/sensor-bridge-state.json
BRIDGE_STATE_FILE=
# default 15728640
BRIDGE_MAX_ASSET_BYTES=
# First run only: comma-separated existing relay asset ids to import (see `pnpm sensor-bridge list`); others are skipped
BRIDGE_IMPORT_EXISTING=
# Viewer credential of the local mock relay (`pnpm mock-relay`; default dev-viewer-credential)
MOCK_RELAY_CREDENTIAL=

# --- Identity, devices and operations (capture v2) ---------------------------
# Identity email: resend | ses | file | none (default none: in-memory outbox in
# development, fail-closed 503 in production). "file" writes 0600 JSON files for
# local dev only. Production is Resend (owner decision; the on-prem host sends
# through Resend's HTTPS API): docker-compose.yml defaults to resend and its
# preflight refuses anything else. ses remains available for the AWS template.
IDENTITY_MAIL_DRIVER=
# Sender on a domain verified in Resend, e.g. "culture atlas <no-reply@example.com>"
IDENTITY_MAIL_FROM=
# Resend API key with sending access only (resend.com → API Keys)
RESEND_API_KEY=
# ses only: region (default AWS_REGION), optional configuration set, credentials
IDENTITY_MAIL_SES_REGION=
IDENTITY_MAIL_SES_CONFIGURATION_SET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# default .data/dev-mail (file driver)
IDENTITY_MAIL_FILE_DIR=
# Push wake-ups for queued device commands: none (default) | live
PUSH_DRIVER=
# APNs token auth (.p8 PEM, "\n" escapes allowed), team/key ids and app bundle id
PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_ID=
PUSH_APNS_PRIVATE_KEY=
PUSH_APNS_TOPIC=
# FCM HTTP v1 service account
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CLIENT_EMAIL=
PUSH_FCM_PRIVATE_KEY=
# Global kill switches, comma-separated flag names (only turn features off)
FEATURE_KILL_SWITCHES=
# Experimental glasses activation inputs (all must pass; see feature-flags.json)
# Operator-qualified builds with the real SDK, e.g. ios@1.4.0
META_GLASSES_QUALIFIED_BUILDS=
# Platforms whose release-channel entitlement is verified, e.g. ios
META_GLASSES_ENTITLED_PLATFORMS=
# none (default) | allowlist | all
META_GLASSES_ROLLOUT=
META_GLASSES_ROLLOUT_ACCOUNT_IDS=
# true only after audio qualification
META_GLASSES_AUDIO_QUALIFIED=
# Operator opt-ins for default-off flags: true to enable
AUTOMATIC_ANALYSIS_ENABLED=
NATIVE_VIDEO_MODEL_INPUT_ENABLED=
AGENT_REMOTE_CAPTURE_ENABLED=
# default on; false turns the feature off
AGENT_API_ENABLED=
COLLECTION_SHARING_ENABLED=
# Spec amendment 2.2, default on; false turns the feature off:
# sign-up taste questionnaire blocks the personal feed until 3 picks
ONBOARDING_REQUIRED=
# taste_seed job seeds a new account's feed from its picks
TASTE_SEED_ENABLED=
# "While we look" feed strip during photo processing
WHILE_WE_LOOK_ENABLED=
# Independent verifier (vision_verify, another model family, binding before
# publication), default OFF. Both tune-split evaluations kept it off
# (docs/quality-plan.md §15: it contested no forbidden label; §18.10, round 3:
# it blocked 22 claims, 1 forbidden, 20 label-good and 1 unlabelled, M4 and M5
# outside their gates); it also needs a qualified role. The kill switch
# analysis_verifier_enabled turns it off. When set, the v2 media result also
# leaves out the claims the verifier checks (they wait for the compile job)
ANALYSIS_VERIFIER_ENABLED=
# PR 8 interest graph, default OFF. Projection only lets effective explicit
# taste mutations (saves, picks, exclusions, anonymous claim) queue their
# private graph projection intents; it never switches live ranking/reasons or
# buys research. The kill switch interest_graph_projection_enabled turns it off.
INTEREST_GRAPH_PROJECTION_ENABLED=
# PR 8 graph-assisted discovery, default OFF, requires projection on too.
# Controls graph expansion/publication only (never legacy paths); the kill
# switch interest_graph_discovery_enabled turns it off.
INTEREST_GRAPH_DISCOVERY_ENABLED=
# PR 8 paid relation research, default OFF. The opt-in alone dispatches
# nothing: relation research also requires an actually qualified research_text
# role (a demo-allowed role is never qualification) and durable account/global
# spend limits (the model gateway's ledger), and EVERY paid leg of the
# effective claims chain must reserve through that ledger. MODEL_FALLBACK=
# elorian adds an unreserved paid fallback leg, so it keeps paid research
# off (the gate refuses with fallback_unreserved) while unrelated legacy model
# fallback keeps working; the kill switch interest_graph_research_enabled also
# turns research off. The all-time MODEL_TOTAL_SPEND_LIMIT_USD ceiling is part
# of the durable budget: research stays off without it.
INTEREST_GRAPH_RESEARCH_ENABLED=
# PR 8 framework shadow pass, default OFF. Shadow only observes and records
# never-live framework output for offline comparison: it never changes a live
# feed, ranking or reason, and never buys research. The kill switch
# interest_graph_framework_shadow_enabled turns it off.
INTEREST_GRAPH_FRAMEWORK_SHADOW_ENABLED=
# pnpm ops:metrics namespace/dimension (default CultureAtlas / NODE_ENV)
OPS_METRICS_NAMESPACE=
OPS_ENVIRONMENT=

# --- Demo agent (apps/demo-agent, independent MCP client) ------------------
# default http://localhost:3000/mcp
DEMO_AGENT_MCP_URL=
# Agent connection credential (cat_...) issued in account settings
DEMO_AGENT_TOKEN=
# Optional model used by the demo agent to phrase requests
DEMO_AGENT_MODEL=

# --- Browser tests ------------------------------------------------------------
# Use an already running app instead of starting `pnpm dev`
E2E_BASE_URL=
# Preinstalled Chromium location (never run `playwright install`)
PLAYWRIGHT_BROWSERS_PATH=
