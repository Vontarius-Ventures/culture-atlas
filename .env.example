# culture atlas environment variables.
# Names only: never commit real values. Defaults (in comments) apply when unset.
# Domain config: packages/domain/src/config.ts
# Provider config: packages/providers/src/config.ts
# Bridge config: apps/sensor-bridge/src/config.ts

# --- Runtime ---------------------------------------------------------------
# development | test | production (default development)
NODE_ENV=
# Public base URL of the app, used for cookies (Secure when https) and signed media URLs (default http://localhost:3000)
APP_BASE_URL=
# HMAC secret for session tokens and CSRF; REQUIRED in production
SESSION_SECRET=
# base64 32-byte key for AES-256-GCM encryption of sensor viewer credentials
CREDENTIAL_ENCRYPTION_KEY=
# Version tag included in analysis cache keys; bump to invalidate cached analyses
COMPILER_VERSION=

# --- Database --------------------------------------------------------------
# default postgres://culture_atlas:culture_atlas@localhost:5432/culture_atlas
DATABASE_URL=
# default 10
DATABASE_POOL_MAX=
# Base database for tests; each vitest run creates and drops its own database from it
# (default postgres://culture_atlas:culture_atlas@localhost:5432/culture_atlas_test)
TEST_DATABASE_URL=

# --- Sessions, quotas and limits ------------------------------------------
# default 24
ANON_SESSION_TTL_HOURS=
# default 30
ACCOUNT_SESSION_TTL_DAYS=
# default 30
AGENT_TOKEN_DEFAULT_TTL_DAYS=
# default 15728640 (15 MiB)
UPLOAD_MAX_BYTES=
# default 40000000 decoded pixels
UPLOAD_MAX_PIXELS=
# default 2048 px long edge for the stored derivative
IMAGE_MAX_EDGE=
# Keep original uploads in addition to the derivative (default false)
STORE_ORIGINALS=
# default 10 / 5 per anonymous session per day
ANON_DAILY_ANALYSES=
ANON_DAILY_PLANS=
# default 100 / 50 per account per day
ACCOUNT_DAILY_ANALYSES=
ACCOUNT_DAILY_PLANS=
# default 2000 requests per IP per day
IP_DAILY_REQUESTS=
# Comma-separated account ids allowed to open the demo inspector for their own jobs
DEMO_INSPECTOR_ACCOUNT_IDS=

# --- Worker ----------------------------------------------------------------
# default 5 concurrent jobs
WORKER_CONCURRENCY=
# default 500
WORKER_POLL_MS=
# default 30000 / 10000
JOB_LEASE_MS=
JOB_HEARTBEAT_MS=
# default 3
JOB_MAX_ATTEMPTS=
# default 60000 (per analysis attempt)
ANALYSIS_DEADLINE_MS=
# Per-job budgets (defaults 12 / 5 / 2)
JOB_MAX_QLOO_REQUESTS=
JOB_MAX_RESEARCH_REFS=
JOB_MAX_PROVIDER_RETRIES=

# --- VLM / text models (Anthropic) -----------------------------------------
# Absent key => VLM/text capabilities report unavailable
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# default claude-sonnet-5-5
VLM_MODEL=
# default claude-sonnet-5-5
RESEARCH_MODEL=
# Plan composer model (defaults to RESEARCH_MODEL)
COMPOSER_MODEL=
# default 30000
VLM_TIMEOUT_MS=
# low | medium | high (default medium) effort for VLM and text calls
ANTHROPIC_EFFORT=
# Server-side refusal fallback on supported models; disabled automatically with ANTHROPIC_BASE_URL (default true)
ANTHROPIC_REFUSAL_FALLBACK=

# --- Qloo --------------------------------------------------------------------
# Absent key => every Qloo capability reports unavailable; nothing is fabricated
QLOO_API_KEY=
# default https://hackathon.api.qloo.com
QLOO_API_URL=
# default 10000
QLOO_TIMEOUT_MS=
# Allow recorded fixtures, always labeled "Example result" (default false)
QLOO_REPLAY_FIXTURES=
# Directory of sanitized real recordings from scripts/probe-qloo.ts --record (e.g. fixtures/qloo/recordings)
QLOO_REPLAY_DIR=

# --- Reference research (Wikipedia / Wikimedia) ---------------------------
# default https://en.wikipedia.org/api/rest_v1
WIKIPEDIA_API_URL=
# default https://en.wikipedia.org/w/api.php
WIKIPEDIA_ACTION_API_URL=
# Descriptive User-Agent with contact info, required by Wikimedia
WIKIMEDIA_USER_AGENT=
# default 8000 per Wikipedia request
RESEARCH_TIMEOUT_MS=

# --- Object storage ---------------------------------------------------------
# local | s3 | memory (default local)
STORAGE_DRIVER=
# default .data/objects
STORAGE_LOCAL_DIR=
# HMAC secret for local signed media URLs
STORAGE_SIGNING_SECRET=
# default 300
SIGNED_URL_TTL_SECONDS=
S3_ENDPOINT=
# default us-east-1
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO-style endpoints (default false)
S3_FORCE_PATH_STYLE=

# --- World Sensor (server-side poller) -------------------------------------
# Comma-separated relay origins an operator may configure
SENSOR_ALLOWED_ORIGINS=
# default 10000
SENSOR_POLL_INTERVAL_MS=
# default 15728640
SENSOR_MAX_ASSET_BYTES=

# --- World Sensor outbound bridge (apps/sensor-bridge, runs beside the relay) ---
BRIDGE_RELAY_ORIGIN=
BRIDGE_VIEWER_CREDENTIAL=
BRIDGE_APP_URL=
BRIDGE_CAPTURE_TOKEN=
BRIDGE_CONNECTION_ID=
# default 10000
BRIDGE_POLL_INTERVAL_MS=
# default .data/sensor-bridge-state.json
BRIDGE_STATE_FILE=
# default 15728640
BRIDGE_MAX_ASSET_BYTES=

# --- Demo agent (apps/demo-agent, independent MCP client) ------------------
# default http://localhost:3000/mcp
DEMO_AGENT_MCP_URL=
# Agent connection credential (cat_...) issued in account settings
DEMO_AGENT_TOKEN=
# Optional model used by the demo agent to phrase requests
DEMO_AGENT_MODEL=

# --- Browser tests ------------------------------------------------------------
# Use an already running app instead of starting `pnpm dev`
E2E_BASE_URL=
# Preinstalled Chromium location (never run `playwright install`)
PLAYWRIGHT_BROWSERS_PATH=
