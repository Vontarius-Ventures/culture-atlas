{
  "$id": "https://culture-atlas.invalid/schemas/v2/CreateShareRequest.json",
  "title": "CreateShareRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "audience": {
      "default": "restricted",
      "type": "string",
      "enum": [
        "restricted",
        "link"
      ]
    },
    "expires_in_days": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 7
        },
        {
          "type": "number",
          "const": 30
        }
      ]
    },
    "include_media": {
      "default": false,
      "type": "boolean"
    },
    "allow_originals": {
      "default": false,
      "type": "boolean"
    },
    "confirm_policy": {
      "default": false,
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
