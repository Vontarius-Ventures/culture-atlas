{
  "name": "culture-atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @culture-atlas/web dev",
    "build": "pnpm -r --filter=!culture-atlas run build",
    "typecheck": "pnpm -r --filter=!culture-atlas run typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @culture-atlas/web test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:setup": "bash scripts/dev-db.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "pnpm --filter @culture-atlas/worker start",
    "media-worker": "pnpm --filter @culture-atlas/media-worker start",
    "sensor-bridge": "pnpm --filter @culture-atlas/sensor-bridge exec tsx src/main.ts",
    "demo-agent": "pnpm --filter @culture-atlas/demo-agent start",
    "qloo:probe": "tsx scripts/qloo-probe.ts",
    "onboarding:catalog": "tsx scripts/build-onboarding-catalog.ts",
    "qualify:concentrate": "tsx scripts/qualify-concentrate.ts",
    "eval:fetch": "tsx scripts/eval-fetch.ts",
    "eval:replay": "tsx scripts/eval-replay.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "eval:binding": "tsx scripts/eval-binding.ts",
    "eval:lint-labels": "tsx scripts/eval-lint-labels.ts",
    "eval:style": "tsx scripts/eval-style.ts",
    "style:harvest-vocab": "tsx scripts/style/harvest-vocab.ts",
    "style:build-vocab": "tsx scripts/style/build-vocab.ts",
    "style:live-check": "tsx scripts/style/live-check.ts",
    "mock-relay": "pnpm --filter @culture-atlas/sensor-bridge mock-relay",
    "ops:kill": "tsx scripts/feature-kill.ts",
    "ops:metrics": "tsx scripts/ops-metrics.ts",
    "ops:restore-drill": "tsx scripts/restore-drill.ts",
    "ops:backup": "tsx scripts/capture-backup.ts",
    "ops:preflight": "tsx scripts/production-env.ts",
    "ops:storage": "tsx scripts/object-store.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  }
}
