{
  "$id": "https://culture-atlas.invalid/schemas/v2/OAuthTokenRequest.json",
  "title": "OAuthTokenRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "grant_type": {
          "type": "string",
          "const": "authorization_code"
        },
        "client_id": {
          "type": "string"
        },
        "redirect_uri": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "code_verifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{43,128}$"
        },
        "resource": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "grant_type",
        "client_id",
        "redirect_uri",
        "code",
        "code_verifier",
        "resource"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "grant_type": {
          "type": "string",
          "const": "refresh_token"
        },
        "client_id": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "resource": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "grant_type",
        "client_id",
        "refresh_token",
        "resource"
      ],
      "additionalProperties": false
    }
  ]
}
