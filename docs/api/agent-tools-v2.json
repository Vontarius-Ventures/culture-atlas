{
  "schema_version": "2.1",
  "catalog_version": "2.3.0",
  "tools": [
    {
      "name": "list_media",
      "description": "List or search media within the live collection grant. No originals or private analysis reasoning.",
      "scopes": [
        "media:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video",
              "audio"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_upload",
              "verifying",
              "processing",
              "ready",
              "failed"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "browser_camera",
              "phone_camera",
              "meta_glasses",
              "upload",
              "legacy_sensor",
              "browser_microphone",
              "phone_microphone"
            ]
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "search": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    {
      "name": "get_media",
      "description": "Read one currently permitted media item and authorized preview links. Originals require a separate download grant.",
      "scopes": [
        "media:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "media_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "media_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "begin_upload",
      "description": "Begin byte intake, not analysis. Selected-collection agents must name a granted destination. Never accepts a URL or file path.",
      "scopes": [
        "media:write"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "upload": {
            "type": "object",
            "properties": {
              "client_capture_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "photo",
                  "video"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "browser_camera",
                  "phone_camera",
                  "meta_glasses",
                  "upload"
                ]
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "content_type": {
                "type": "string",
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/webp",
                  "video/mp4",
                  "video/quicktime",
                  "video/webm"
                ]
              },
              "byte_size": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 262144000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "captured_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "capture_session_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "destination_collection_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "client_capture_id",
              "kind",
              "source",
              "filename",
              "content_type",
              "byte_size",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "idempotency_key",
          "upload"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "complete_upload",
      "description": "Submit signed byte-transfer receipts for a draft created by this connection. Check get_operation using upload_id. Analysis is never automatic.",
      "scopes": [
        "media:write"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "completion": {
            "type": "object",
            "properties": {
              "parts": {
                "minItems": 1,
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "part_number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    },
                    "etag": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "part_number",
                    "etag"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "parts"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "upload_id",
          "idempotency_key",
          "completion"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "analyze_media",
      "description": "Explicitly request analysis of one permitted, prepared photo or selected video moments. Analysis is never automatic; consent, the daily allowance and spend limits apply. Returns an analysis_id: check it with get_operation. No result links or private reasoning are returned.",
      "scopes": [
        "media:analyze"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "media_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "request": {
            "type": "object",
            "properties": {
              "focus": {
                "default": "",
                "type": "string",
                "maxLength": 500
              },
              "mode": {
                "type": "string",
                "enum": [
                  "photo",
                  "selected_frame",
                  "sampled_video"
                ]
              },
              "frame_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "timestamp_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "expected_generation": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "mode",
              "expected_generation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "media_id",
          "idempotency_key",
          "request"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_operation",
      "description": "Check an authorized asynchronous upload, analysis or capture command. This does not broaden resource access.",
      "scopes": [],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "operation_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "request_capture",
      "description": "Request capture on an explicitly selected phone and fresh locally armed session. Take installation_id from get_setup installations[].id and command.session_id / command.generation from that installation's armed_session (present only while the owner has armed the phone for this connection). Cannot arm a phone. Check the returned command through get_operation. Uncertain or expired capture must not be retried as a new request.",
      "scopes": [
        "devices:command"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "command": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "generation": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "action": {
                "type": "string",
                "enum": [
                  "capture_photo",
                  "start_video",
                  "stop_video"
                ]
              },
              "capture_client_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "duration_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "expires_in_seconds": {
                "default": 30,
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              }
            },
            "required": [
              "session_id",
              "generation",
              "action",
              "capture_client_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "installation_id",
          "idempotency_key",
          "command"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_setup",
      "description": "Read safe capabilities and device aliases. Observations never grant OS permissions or arm a camera.",
      "scopes": [
        "setup:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_preferences",
      "description": "Read explicit and effective ordinary account preferences. This does not reveal taste.",
      "scopes": [
        "preferences:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "update_preferences",
      "description": "Change only ordinary preferences using the version returned by get_preferences. Cannot enable capture, microphones, sharing or automatic analysis.",
      "scopes": [
        "preferences:write"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "patch": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string",
                "enum": [
                  "system",
                  "light",
                  "dark"
                ]
              },
              "language": {
                "type": "string",
                "enum": [
                  "en",
                  "es",
                  "fr",
                  "de",
                  "ja"
                ]
              },
              "default_capture_mode": {
                "type": "string",
                "enum": [
                  "photo",
                  "video"
                ]
              },
              "video_muted": {
                "type": "boolean"
              },
              "exploration": {
                "type": "string",
                "enum": [
                  "familiar",
                  "balanced",
                  "adventurous"
                ]
              },
              "food": {
                "type": "object",
                "properties": {
                  "exclusions": {
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                },
                "required": [
                  "exclusions"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "version",
          "patch"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "analyze_capture",
      "description": "Start discovery for a photo you uploaded via POST /v1/uploads (pass its upload_id; URLs and file paths are not accepted). Returns immediately with job_id; call get_job until complete, then get_capture.",
      "scopes": [
        "captures:write"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "focus": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "whole"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "choice"
                  },
                  "choice_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "choice_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "region"
                  },
                  "box": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "w": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "h": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w",
                      "h"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "box"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "upload_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_job",
      "description": "Get the state, progress stage and completed sections of a job started by another tool.",
      "scopes": [],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_capture",
      "description": "Get a capture’s interpretation, references and recommended discoveries.",
      "scopes": [
        "captures:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "capture_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "capture_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_captures",
      "description": "List the newest captures this connection can see, newest first: compiled analysis title, detected references and recommended discovery item ids (open them with get_item). Use this for \"things like my last capture\". No photos or private reasoning.",
      "scopes": [
        "captures:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_item",
      "description": "Read one discovery item (film, music, place, dish, style...) with its related items (related[] and related_state). Call this after discover_related completes to see what it found. Selected-collection connections pass the collection_id containing the item.",
      "scopes": [],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "collection_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_discoveries",
      "description": "Read the user’s personal discovery feed (cards with title, category, image and why_this), optionally for one category. Cursor-paginated; pass next_cursor to continue.",
      "scopes": [
        "taste:read"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "wear",
              "play",
              "watch",
              "eat"
            ]
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "list_saved",
      "description": "List items the user explicitly saved, newest first (cursor-paginated). filter \"unfiled\" returns saved items in no collection.",
