{
  "$id": "https://culture-atlas.invalid/schemas/v2/OAuthConsent.json",
  "title": "OAuthConsent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "redirect_uri": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "code_challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "code_challenge_method": {
      "type": "string",
      "const": "S256"
    },
    "state": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512
    },
    "resource": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "grant": {
      "type": "object",
      "properties": {
        "client_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "scopes": {
          "default": [
            "setup:read",
            "preferences:read"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "captures:read",
              "captures:write",
              "collections:read",
              "collections:write",
              "taste:read",
              "taste:write",
              "plans:read",
              "plans:write",
              "setup:read",
              "preferences:read",
              "preferences:write",
              "media:read",
              "media:download",
              "media:write",
              "media:analyze",
              "devices:command"
            ]
          }
        },
        "library_access": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "selected_collections",
            "all"
          ]
        },
        "collection_ids": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "installation_ids": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "expires_in_days": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      },
      "required": [
        "client_name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "client_id",
    "redirect_uri",
    "code_challenge",
    "code_challenge_method",
    "state",
    "resource",
    "grant"
  ],
  "additionalProperties": false
}
