{
  "$id": "https://culture-atlas.invalid/schemas/v2/SharedCollection.json",
  "title": "SharedCollection",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.1"
    },
    "request_id": {
      "type": "string"
    },
    "share": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "audience": {
          "type": "string",
          "enum": [
            "restricted",
            "link"
          ]
        },
        "view_only": {
          "type": "boolean",
          "const": true
        },
        "include_media": {
          "type": "boolean"
        },
        "allow_originals": {
          "type": "boolean"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "audience",
        "view_only",
        "include_media",
        "allow_originals",
        "expires_at",
        "policy_version"
      ]
    },
    "collection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "description",
        "owner_display_name"
      ]
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "capture",
              "style",
              "brand",
              "artist",
              "track",
              "film",
              "food",
              "reference"
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "wear",
                  "play",
                  "watch",
                  "eat"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "alt": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "width",
                  "height",
                  "alt"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "destination_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_example": {
            "type": "boolean"
          },
          "saveable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "category",
          "title",
          "subtitle",
          "description",
          "detail",
          "image",
          "destination_url",
          "is_example",
          "saveable"
        ]
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "poster_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "playback_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "width",
          "height",
          "duration_ms",
          "poster_url",
          "playback_url",
          "original_url"
        ]
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "share",
    "collection",
    "discoveries",
    "media",
    "truncated"
  ]
}
