{
  "fixture_version": 1,
  "note": "Native owner bridge for apps/ios and apps/android: taste onboarding (spec amendment 2.2, screens 14, 15 and 18) plus Discover, item detail, related discoveries, and boards. Wire bodies are in messages.json. The TS test checks routes against ROUTES and the native owner bridge, copy against design/copy.json, limits against the server schemas, and every decision table against its reference implementation.",
  "auth": {
    "bearer": "native access token (cna_), the same session the app uses for /v2",
    "operations": [
      "GET /v1/onboarding/catalog",
      "GET /v1/onboarding/search",
      "POST /v1/onboarding/picks",
      "DELETE /v1/onboarding/picks/{id}",
      "PUT /v1/onboarding/exclusions",
      "POST /v1/onboarding/complete",
      "GET /v1/onboarding/state",
      "GET /v1/onboarding/seed",
      "GET /v1/taste/picks",
      "POST /v1/taste/picks",
      "DELETE /v1/taste/picks/{id}",
      "GET /v1/discoveries",
      "GET /v1/items/{id}",
      "POST /v1/items/{id}/discoveries",
      "GET /v1/collections",
      "POST /v1/collections",
      "GET /v1/collections/{id}",
      "PUT /v1/collections/{id}/items/{item_id}",
      "GET /v1/captures/{id}",
      "POST /v1/captures/{id}/style/retry",
      "PUT /v1/me/city"
    ],
    "mutation_headers": [
      "Idempotency-Key",
      "X-Atlas-Expected-Account"
    ],
    "error_body": "flat",
    "error_body_example": "v1_error_body",
    "other_v1_routes_refuse_with": "scope_denied"
  },
  "routes": {
    "catalog": {
      "route": "GET /v1/onboarding/catalog",
      "operation": "getOnboardingCatalog"
    },
    "search": {
      "route": "GET /v1/onboarding/search",
      "operation": "searchOnboarding"
    },
    "create_pick": {
      "route": "POST /v1/onboarding/picks",
      "operation": "createOnboardingPick"
    },
    "delete_pick": {
      "route": "DELETE /v1/onboarding/picks/{id}",
      "operation": "deleteOnboardingPick"
    },
    "exclusions": {
      "route": "PUT /v1/onboarding/exclusions",
      "operation": "putOnboardingExclusions"
    },
    "complete": {
      "route": "POST /v1/onboarding/complete",
      "operation": "completeOnboarding"
    },
    "state": {
      "route": "GET /v1/onboarding/state",
      "operation": "getOnboardingState"
    },
    "seed": {
      "route": "GET /v1/onboarding/seed",
      "operation": "getOnboardingSeed"
    },
    "taste_picks": {
      "route": "GET /v1/taste/picks",
      "operation": "listTastePicks"
    },
    "create_taste_pick": {
      "route": "POST /v1/taste/picks",
      "operation": "createTastePick"
    },
    "delete_taste_pick": {
      "route": "DELETE /v1/taste/picks/{id}",
      "operation": "deleteTastePick"
    },
    "discoveries": {
      "route": "GET /v1/discoveries",
      "operation": "getDiscoveries"
    },
    "item": {
      "route": "GET /v1/items/{id}",
      "operation": "getItem"
    },
    "discover_related": {
      "route": "POST /v1/items/{id}/discoveries",
      "operation": "discoverRelated"
    },
    "list_collections": {
      "route": "GET /v1/collections",
      "operation": "listCollections"
    },
    "create_collection": {
      "route": "POST /v1/collections",
      "operation": "createCollection"
    },
    "get_collection": {
      "route": "GET /v1/collections/{id}",
      "operation": "getCollection"
    },
    "add_collection_item": {
      "route": "PUT /v1/collections/{id}/items/{item_id}",
      "operation": "addCollectionItem"
    },
    "capture": {
      "route": "GET /v1/captures/{id}",
      "operation": "getCapture"
    },
    "style_retry": {
      "route": "POST /v1/captures/{id}/style/retry",
      "operation": "retryStyle"
    },
    "set_city": {
      "route": "PUT /v1/me/city",
      "operation": "setCity"
    }
  },
  "limits": {
    "min_picks": 3,
    "max_picks": 60,
    "search_query_min_chars": 2,
    "search_query_max_chars": 80,
    "search_results_max": 10,
    "exclusions_max": 12,
    "exclusion_max_chars": 40
  },
  "categories": [
    "wear",
    "play",
    "watch",
    "eat"
  ],
  "category_copy_keys": {
    "wear": "onboarding.group.wear",
    "play": "onboarding.group.play",
    "watch": "onboarding.group.watch",
    "eat": "onboarding.group.eat"
  },
  "exclusion_suggestions": [
